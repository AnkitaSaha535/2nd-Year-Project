#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char message[100];
    int key, choice;

    printf("LOCK SYSTEM\n");
    printf("1. Lock a Note\n");
    printf("2. Unlock a Note\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    getchar(); 

    printf("Enter sentence: ");
    fgets(message, sizeof(message), stdin);
    message[strcspn(message, "\n")] = 0; 

    printf("Enter numeric key (1-25): ");
    scanf("%d", &key);

    if (choice == 1) {
        for(int i = 0; message[i] != '\0'; i++) {
            if(isupper(message[i]))
                message[i] = ((message[i] - 'A' + key) % 26) + 'A';
            else if(islower(message[i]))
                message[i] = ((message[i] - 'a' + key) % 26) + 'a';
        }
        printf("\nLocked Sentence: %s\n", message);
    } 
    else if (choice == 2) {
        for(int i = 0; message[i] != '\0'; i++) {
            if(isupper(message[i]))
                message[i] = ((message[i] - 'A' - key + 26) % 26) + 'A';
            else if(islower(message[i]))
                message[i] = ((message[i] - 'a' - key + 26) % 26) + 'a';
        }
        printf("\nUnlocked Sentence: %s\n", message);
    } 
    else {
        printf("\nInvalid Choice!\n");
    }

    return 0;
}

